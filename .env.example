# Copia in .env solo per sviluppo/test locale. Mai committare .env.
# Le credenziali del provider si inseriscono dalla UI: queste servono solo agli script di test.
XTREAM_HOST=http://esempio.com:8080
XTREAM_USER=
XTREAM_PASS=
